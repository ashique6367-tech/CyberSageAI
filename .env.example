# CyberSage AI - Environment Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:8000
MAX_UPLOAD_MB=5
MAX_TEXT_CHARS=20000

# Gemma 4 Provider Configuration
# Options: "demo" (default, labelled simulation), "ollama", "huggingface", "openai_compatible"
GEMMA_PROVIDER=demo
# Supported models include: google/gemma-4-E4B-it, google/gemma-4-E2B-it, google/gemma-4-26B-A4B-it, gemma4
GEMMA_MODEL=google/gemma-4-E4B-it
# Base URL for Ollama or local OpenAI-compatible inference server
GEMMA_API_BASE=http://localhost:11434/v1
# API key (leave blank for local Ollama; provide token for Hugging Face or remote endpoint)
GEMMA_API_KEY=

# Optional Threat Intelligence Integration
# Options: "none" (default), "virustotal" (when key provided)
THREAT_INTEL_PROVIDER=none
THREAT_INTEL_API_KEY=
